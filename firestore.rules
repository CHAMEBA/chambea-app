rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function loggedIn() { return request.auth != null; }
    function jobData(jobId) {
      return get(/databases/$(database)/documents/chambea_jobs/$(jobId)).data;
    }
    function owner(jobId) {
      return loggedIn() && jobData(jobId).ownerUid == request.auth.uid;
    }
    function participant(jobId, providerId) {
      return loggedIn() && (owner(jobId) || providerId == request.auth.uid)
        && exists(/databases/$(database)/documents/chambea_jobs/$(jobId)/quotes/$(providerId));
    }
    function changeOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }
    function acceptRealQuote(jobId) {
      return owner(jobId)
        && resource.data.status == 'open'
        && request.resource.data.status == 'accepted'
        && changeOnly(['status','acceptedProviderUid','acceptedAmount','paymentStatus','workStatus','updatedAt'])
        && request.resource.data.acceptedProviderUid is string
        && request.resource.data.acceptedAmount is number
        && request.resource.data.acceptedAmount > 0
        && request.resource.data.paymentStatus == 'unpaid'
        && request.resource.data.workStatus == 'accepted'
        && request.resource.data.updatedAt is timestamp
        && exists(/databases/$(database)/documents/chambea_jobs/$(jobId)/quotes/$(request.resource.data.acceptedProviderUid))
        && get(/databases/$(database)/documents/chambea_jobs/$(jobId)/quotes/$(request.resource.data.acceptedProviderUid)).data.amount == request.resource.data.acceptedAmount
        && get(/databases/$(database)/documents/chambea_jobs/$(jobId)/quotes/$(request.resource.data.acceptedProviderUid)).data.status == 'sent';
    }
    function agreementData(jobId) {
      return get(/databases/$(database)/documents/chambea_jobs/$(jobId)/agreements/current).data;
    }
    function readyForTestPayment(jobId) {
      return exists(/databases/$(database)/documents/chambea_jobs/$(jobId)/agreements/current)
        && agreementData(jobId).appointmentStatus == 'confirmed'
        && agreementData(jobId).visitStatus == 'inspected'
        && agreementData(jobId).revisionStatus in ['original_confirmed','approved'];
    }
    function approvedRevisedPrice(jobId) {
      return owner(jobId)
        && resource.data.status == 'accepted'
        && resource.data.paymentStatus in ['unpaid','declined']
        && readyForTestPayment(jobId)
        && agreementData(jobId).revisionStatus == 'approved'
        && resource.data.acceptedAmount == agreementData(jobId).baseAmount
        && changeOnly(['acceptedAmount','updatedAt'])
        && request.resource.data.acceptedAmount == agreementData(jobId).revisedAmount
        && request.resource.data.updatedAt == request.time;
    }
    function testPaymentChange(jobId) {
      return owner(jobId)
        && resource.data.status == 'accepted'
        && changeOnly(['paymentStatus','updatedAt'])
        && request.resource.data.updatedAt is timestamp
        && ((resource.data.paymentStatus in ['unpaid','declined']
            && request.resource.data.paymentStatus == 'simulated_paid'
            && readyForTestPayment(jobId)
            && (agreementData(jobId).revisionStatus != 'approved'
                || resource.data.acceptedAmount == agreementData(jobId).revisedAmount))
          || (resource.data.paymentStatus == 'unpaid' && request.resource.data.paymentStatus == 'declined')
          || (resource.data.paymentStatus == 'simulated_paid'
            && resource.data.workStatus == 'completed'
            && request.resource.data.paymentStatus == 'released'));
    }
    function providerWorkChange() {
      return loggedIn()
        && resource.data.status == 'accepted'
        && resource.data.acceptedProviderUid == request.auth.uid
        && resource.data.paymentStatus == 'simulated_paid'
        && changeOnly(['workStatus','updatedAt'])
        && request.resource.data.updatedAt is timestamp
        && ((resource.data.workStatus == 'accepted' && request.resource.data.workStatus == 'started')
          || (resource.data.workStatus == 'started' && request.resource.data.workStatus == 'completed'));
    }
    function providerWithdrawChange() {
      return loggedIn()
        && resource.data.status == 'accepted'
        && resource.data.acceptedProviderUid == request.auth.uid
        && resource.data.paymentStatus == 'released'
        && !resource.data.keys().hasAny(['withdrawStatus'])
        && changeOnly(['withdrawStatus','updatedAt'])
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.withdrawStatus == 'withdrawn';
    }
    match /usuarios/{uid} {
      allow read, write: if loggedIn() && uid == request.auth.uid;
    }
    match /chambea_jobs/{jobId} {
      // Piloto: catálogo visible solo para personas con sesión iniciada.
      allow read: if loggedIn();
      allow create: if loggedIn()
        && request.resource.data.keys().hasOnly(['ownerUid','category','description','zone','budget','status','createdAt'])
        && request.resource.data.keys().hasAll(['ownerUid','category','description','zone','budget','status','createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.category is string
        && request.resource.data.category.size() > 0
        && request.resource.data.category.size() <= 70
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10
        && request.resource.data.description.size() <= 1200
        && request.resource.data.zone is string
        && request.resource.data.zone.size() >= 2
        && request.resource.data.zone.size() <= 100
        && request.resource.data.budget is number
        && request.resource.data.budget >= 0
        && request.resource.data.budget <= 10000000
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;
      allow update: if loggedIn() && (
        acceptRealQuote(jobId) || approvedRevisedPrice(jobId) || testPaymentChange(jobId)
        || providerWorkChange() || providerWithdrawChange()
      );
      allow delete: if false;
      // Coordinación privada: sólo cliente y proveedor adjudicado.
      // No guardar direcciones ni teléfonos en solicitudes públicas.
      match /agreements/{agreementId} {
        function assigned() {
          return loggedIn()
            && jobData(jobId).status == 'accepted'
            && (jobData(jobId).ownerUid == request.auth.uid
              || jobData(jobId).acceptedProviderUid == request.auth.uid);
        }
        function isClient() { return assigned() && jobData(jobId).ownerUid == request.auth.uid; }
        function isProvider() { return assigned() && jobData(jobId).acceptedProviderUid == request.auth.uid; }
        function beforeCharge() {
          return assigned() && jobData(jobId).paymentStatus in ['unpaid','declined'];
        }
        allow get: if agreementId == 'current' && assigned();
        allow list: if false;
        allow create: if agreementId == 'current' && isClient()
          && request.resource.data.keys().hasOnly([
            'clientUid','providerUid','baseAmount','appointmentStatus',
            'visitStatus','revisionStatus','createdAt','updatedAt'])
          && request.resource.data.keys().hasAll([
            'clientUid','providerUid','baseAmount','appointmentStatus',
            'visitStatus','revisionStatus','createdAt','updatedAt'])
          && request.resource.data.clientUid == request.auth.uid
          && request.resource.data.providerUid == jobData(jobId).acceptedProviderUid
          && request.resource.data.baseAmount == jobData(jobId).acceptedAmount
          && request.resource.data.appointmentStatus == 'unscheduled'
          && request.resource.data.visitStatus == 'pending'
          && request.resource.data.revisionStatus == 'none'
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if agreementId == 'current'
          && beforeCharge()
          && request.resource.data.clientUid == resource.data.clientUid
          && request.resource.data.providerUid == resource.data.providerUid
          && request.resource.data.baseAmount == resource.data.baseAmount
          && request.resource.data.updatedAt == request.time
          && (
            // Uno propone fecha y el otro la confirma.
            (resource.data.visitStatus == 'pending'
              && changeOnly(['appointmentAt','appointmentBy','appointmentStatus','updatedAt'])
              && request.resource.data.appointmentStatus == 'proposed'
              && request.resource.data.appointmentBy == request.auth.uid
              && request.resource.data.appointmentAt is timestamp
              && request.resource.data.appointmentAt > request.time
              && request.resource.data.appointmentAt < request.time + duration.value(366,'d'))
            || (resource.data.appointmentStatus == 'proposed'
              && resource.data.appointmentBy != request.auth.uid
              && changeOnly(['appointmentStatus','updatedAt'])
              && request.resource.data.appointmentStatus == 'confirmed')
            // El proveedor confirma que inspeccionó el alcance.
            || (isProvider()
              && resource.data.appointmentStatus == 'confirmed'
              && resource.data.visitStatus == 'pending'
              && changeOnly(['visitStatus','updatedAt'])
              && request.resource.data.visitStatus == 'inspected')
            // El proveedor confirma el importe original.
            || (isProvider()
              && resource.data.visitStatus == 'inspected'
              && resource.data.revisionStatus in ['none','rejected']
              && changeOnly(['revisionStatus','updatedAt'])
              && request.resource.data.revisionStatus == 'original_confirmed')
            // El proveedor propone otro importe con una justificación.
            || (isProvider()
              && resource.data.visitStatus == 'inspected'
              && resource.data.revisionStatus in ['none','rejected']
              && changeOnly(['revisionStatus','revisedAmount','revisionReason','updatedAt'])
              && request.resource.data.revisionStatus == 'pending'
              && request.resource.data.revisedAmount is number
              && request.resource.data.revisedAmount > 0
              && request.resource.data.revisedAmount <= 10000000
              && request.resource.data.revisionReason is string
              && request.resource.data.revisionReason.size() >= 10
              && request.resource.data.revisionReason.size() <= 500)
            // Únicamente el cliente acepta o rechaza el nuevo precio.
            || (isClient()
              && resource.data.revisionStatus == 'pending'
              && changeOnly(['revisionStatus','updatedAt'])
              && request.resource.data.revisionStatus in ['approved','rejected'])
          );
        allow delete: if false;
      }
      match /quotes/{providerId} {
        allow get: if loggedIn() && (owner(jobId) || providerId == request.auth.uid);
        allow list: if owner(jobId);
        allow create: if loggedIn()
          && providerId == request.auth.uid
          && !owner(jobId)
          && jobData(jobId).status == 'open'
          && request.resource.data.keys().hasOnly(['providerUid','clientUid','providerName','amount','note','status','createdAt'])
          && request.resource.data.keys().hasAll(['providerUid','clientUid','providerName','amount','note','status','createdAt'])
          && request.resource.data.providerUid == request.auth.uid
          && request.resource.data.clientUid == jobData(jobId).ownerUid
          && request.resource.data.providerName is string
          && request.resource.data.providerName.size() >= 2
          && request.resource.data.providerName.size() <= 70
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.amount <= 10000000
          && request.resource.data.note is string
          && request.resource.data.note.size() >= 10
          && request.resource.data.note.size() <= 1000
          && request.resource.data.status == 'sent'
          && request.resource.data.createdAt == request.time;
        // Respuestas formales sobre la oferta, antes de adjudicar el trabajo.
        allow update: if loggedIn() && jobData(jobId).status == 'open'
          && request.resource.data.updatedAt == request.time
          && (
            (owner(jobId)
              && resource.data.status == 'sent'
              && request.resource.data.status in ['changes_requested','rejected']
              && changeOnly(['status','updatedAt']))
            || (providerId == request.auth.uid
              && resource.data.status == 'changes_requested'
              && request.resource.data.status == 'sent'
              && changeOnly(['status','amount','note','updatedAt'])
              && request.resource.data.amount is number
              && request.resource.data.amount > 0
              && request.resource.data.amount <= 10000000
              && request.resource.data.note is string
              && request.resource.data.note.size() >= 10
              && request.resource.data.note.size() <= 1000)
          );
        allow delete: if false;
        match /messages/{messageId} {
          allow read: if participant(jobId,providerId);
          allow create: if participant(jobId,providerId)
            && request.resource.data.keys().hasOnly(['senderUid','body','createdAt'])
            && request.resource.data.keys().hasAll(['senderUid','body','createdAt'])
            && request.resource.data.senderUid == request.auth.uid
            && request.resource.data.body is string
            && request.resource.data.body.size() > 0
            && request.resource.data.body.size() <= 800
            && request.resource.data.createdAt == request.time;
          allow update, delete: if false;
        }
      }
    }
  }
}